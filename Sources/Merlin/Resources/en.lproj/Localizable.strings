"onboarding.step12.body" = "Select any text while reading to highlight it in one of five colors. Highlights are synced with your account.";
"onboarding.step12.title" = "Highlights";
"onboarding.step13.body" = "Archived or deleted something by accident? Just shake your phone to undo your last action.";
"onboarding.step13.title" = "Shake to Undo";
"onboarding.step2.body" = "Tap + to save any URL, or share links from your browser, messenger app, and other apps via the Share dialog.";
