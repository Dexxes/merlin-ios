"onboarding.demo.sampleArticle.body" = "Schlechte Wasserqualität und dicht bebaute Ufer: Lange galten Fischotter in Berlin als ausgerottet, seit den 60ern stehen sie unter strengem Schutz, in den 90er Jahren nehmen die Bestände wieder zu. Ebenso wurden die Tiere im 18. und 19. Jahrhundert intensiv bejagt, da sie als Nahrungskonkurrent zum Menschen gesehen wurden und ihr Fell begehrt war. In den vergangenen Jahren konnte sich ihre Population dank Tier- und Naturschutz wieder erholen und wurde vor allem im Ostteil Berlins gesichtet. Der moderne urbane Raum birgt allerdings für Fischotter auch viele Gefahren.";
"onboarding.demo.sampleArticle.byline" = "Von Julian von Bülow · rbb|24 · 8 Min. · Mai 2026";
"onboarding.demo.sampleArticle.meta" = "rbb|24 · 8 Min.";
"onboarding.demo.sampleArticle.title" = "Fischotter könnte in Berlin wieder heimisch werden";
"onboarding.demo.sampleHighlight" = "In einer Zeit endlosen Scrollens wirkt langsames Lesen fast schon radikal. Doch eine wachsende Zahl an Studien legt nahe, dass tiefes, bewusstes Lesen eine der wertvollsten Fähigkeiten sein könnte, die wir kultivieren können.";
"onboarding.step1.body" = "Eine kurze Tour durch die wichtigsten Funktionen.";
"onboarding.step1.title" = "Willkommen bei Merlin!";
"onboarding.step10.body" = "Setze eine Erinnerung, damit du nicht vergisst, einen Artikel zu lesen. Alle Erinnerungen findest du im Navigationsmenü.";
"onboarding.step10.title" = "Erinnerungen";
"onboarding.step11.body" = "Fehlerhafte Formatierung gefunden? Melde den Artikel, damit wir das beheben können.";
"onboarding.step11.title" = "Artikel melden";
"onboarding.step12.body" = "Markiere beim Lesen Text, um ihn in einer von fünf Farben hervorzuheben. Hervorhebungen werden mit deinem Konto synchronisiert.";
"onboarding.step12.title" = "Hervorhebungen";
"onboarding.step13.body" = "Versehentlich etwas archiviert oder gelöscht? Schüttle einfach dein Telefon, um die letzte Aktion rückgängig zu machen.";
"onboarding.step13.title" = "Schütteln zum Rückgängigmachen";
"onboarding.step2.body" = "Tippe auf +, um eine beliebige URL zu speichern, oder teile Links aus deinem Browser, Messenger oder anderen Apps über den Teilen-Dialog.";
"onboarding.step2.title" = "Artikel hinzufügen";
"onboarding.step3.body" = "Wische vom linken Rand, um Artikel zu filtern, Tags zu durchsuchen und die Einstellungen zu öffnen.";
"onboarding.step3.title" = "Navigationsmenü";
"onboarding.step4.body" = "Bevorzugst du eine kompakte Liste oder Karten? Wechsle jederzeit über das Navigationsmenü zwischen Listen- und Kartenansicht.";
"onboarding.step4.title" = "Ansicht wechseln";
"onboarding.step5.body" = "Wische einen Artikel nach links, um ihn zu archivieren, als Favorit zu markieren oder zu löschen.";
"onboarding.step5.title" = "Schnellaktionen";
"onboarding.step6.body" = "Wische einen Artikel nach rechts, um ihn schnell mit Freunden zu teilen oder an eine andere App zu senden.";
"onboarding.step6.title" = "Artikel teilen";
"onboarding.step7.body" = "Wische beim Lesen vom rechten Rand, um zu teilen, Tags zu bearbeiten, Erinnerungen zu setzen und mehr.";
"onboarding.step7.title" = "Lesemenü";
"onboarding.step8.body" = "Passe Schriftart, -größe, Design und Zeilenabstand an deine Lesevorlieben an.";
"onboarding.step8.title" = "Erscheinungsbild";
"onboarding.step9.body" = "Organisiere deine Leseliste mit Tags. Füge sie jederzeit über das Lesemenü hinzu oder entferne sie.";
"onboarding.step9.title" = "Tags";
